# Telegram (from https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once with: python src/generate_session.py
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNEL=mutolaaxona

# LinkedIn (Developer app with "Community Management API" product,
# w_organization_social scope, Company Page admin access)
LINKEDIN_ACCESS_TOKEN=
# e.g. urn:li:organization:102440497 (the id from the admin dashboard URL)
LINKEDIN_ORG_URN=urn:li:organization:102440497

# Optional: if set, Claude is used to pick + polish the daily post.
# If empty, a heuristic (views/forwards/reactions/length) picks the post as-is.
ANTHROPIC_API_KEY=

# IANA timezone used to determine "yesterday"
POST_TIMEZONE=Asia/Tashkent
