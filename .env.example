# Telegram Bot API token (from @BotFather). The bot must be an admin of the
# channel below to receive its posts. Only used by src/bot_collect.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=mutolaaxona

# Required for picking the most meaningful post and translating it to
# English. Get one at https://console.anthropic.com -> API Keys.
# If empty, the longest post is used as-is (untranslated, in Uzbek).
ANTHROPIC_API_KEY=

# IANA timezone used to determine "yesterday"
POST_TIMEZONE=Asia/Tashkent

# Public GitHub Pages URL serving docs/ (Settings -> Pages -> Deploy from
# branch -> main / docs). This becomes the RSS feed's channel link.
# e.g. https://sirojiddinolimov.github.io/linkedin-post/
FEED_BASE_URL=
FEED_TITLE=Mutolaa | Daily pick
FEED_MAX_ITEMS=60
