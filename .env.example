# Telegram (from https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once with: python src/generate_session.py
TELEGRAM_SESSION_STRING=
TELEGRAM_CHANNEL=mutolaaxona
# Optional SOCKS5 proxy. Set host and port together; username/password are
# only needed for providers that require authentication.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Optional: if set, Claude is used to pick + polish the daily post.
# If empty, a heuristic (views/forwards/reactions/length) picks the post as-is.
ANTHROPIC_API_KEY=

# IANA timezone used to determine "yesterday"
POST_TIMEZONE=Asia/Tashkent

# Public GitHub Pages URL serving docs/ (Settings -> Pages -> Deploy from
# branch -> main / docs). This becomes the RSS feed's channel link.
# e.g. https://sirojiddinolimov.github.io/linkedin-post/
FEED_BASE_URL=
FEED_TITLE=Mutolaa | Kunlik tanlov
FEED_MAX_ITEMS=60
